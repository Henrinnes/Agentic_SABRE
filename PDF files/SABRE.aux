\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Operational pipeline with uncertainty-aware, agentic policy. Semantic and behavioural CNNs (with MC Dropout) yield mean scores and per-agent uncertainties. Mean scores are concatenated and CTGAN-augmented for the Decision Agent to produce a fused risk $\hat  {p}$. A policy uses risk threshold $\tau $ and uncertainty threshold $\kappa $ (with optional stricter $\tau _{\text  {high}}$, $\kappa _{\text  {low}}$) to branch to \emph  {AUTO-CONTAIN}, \emph  {ESCALATE}, or \emph  {ALLOW}.\relax }}{18}{}\protected@file@percent }
\newlabel{fig:agentic-Sabre_policy-pipeline}{{1}{18}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Permutation-based feature importance for the behavioural agent, measured as the drop in AUC after permuting each feature independently. Variance- and entropy-driven memory access statistics dominate, indicating that behavioural discrimination relies on irregularity patterns rather than raw activity volume.\relax }}{19}{}\protected@file@percent }
\newlabel{fig:beh_perm}{{2}{19}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Reliability diagram for the fused risk score $\hat  {p}$. The close alignment between predicted probabilities and empirical positive rates indicates strong calibration, validating the use of $\hat  {p}$ as a meaningful risk estimate for downstream triage decisions.\relax }}{19}{}\protected@file@percent }
\newlabel{fig:fusion_reliability}{{3}{19}}
\newlabel{fig:roc_ransmap}{{4a}{20}}
\newlabel{sub@fig:roc_ransmap}{{a}{20}}
\newlabel{fig:roc_rdset}{{4b}{20}}
\newlabel{sub@fig:roc_rdset}{{b}{20}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Receiver operating characteristic (ROC) curves comparing base agents and fusion. \textbf  {Left:} RanSMAP, where behavioural signals are weak and fusion substantially improves separability. \textbf  {Right:} RDset, where the semantic agent already saturates and fusion preserves optimal performance.\relax }}{20}{}\protected@file@percent }
\newlabel{fig:roc_fusion}{{4}{20}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Triage policy geometry in the $(\hat  {p}, \sigma _{\qopname  \relax m{max}})$ space. Horizontal and vertical thresholds correspond to the analytical decision rules in Eqs.\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces 9\hbox {}\unskip \@@italiccorr )}} and \textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces 10\hbox {}\unskip \@@italiccorr )}}, partitioning the space into \textsc  {ALLOW}, \textsc  {ESCALATE}, and \textsc  {AUTO-CONTAIN} regions. Uncertainty acts as a stabilising control variable, preventing overconfident automatic containment.\relax }}{21}{}\protected@file@percent }
\newlabel{fig:triage_space}{{5}{21}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Semantic counterfactual diagnostics for $N=50$ borderline-malicious samples. (Top-left) Distribution of counterfactual distance $\|\Delta z\|_2$. (Top-right) Distribution of relative distance $\|\Delta z\|_2/\|z\|_2$. (Bottom-left) Relationship between original semantic score $p_{\mathrm  {sem}}$ and $\|\Delta z\|_2$. (Bottom-right) Optimisation steps required to reach the target $\theta =0.49$.\relax }}{22}{}\protected@file@percent }
\newlabel{fig:sem_cf_diagnostics}{{6}{22}}
