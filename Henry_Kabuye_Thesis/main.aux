\@writefile{lof}{\contentsline {figure}{\numberline {26}{\ignorespaces Peer consultation effect on the Knowledge Agent. \textbf  {Left:} Probability before versus after consultation for triggered samples (red = ransomware, blue = benign). Points above the diagonal indicate upward corrections by confident peers. \textbf  {Right:} Distribution of probability adjustments ($\Delta p$). The mean positive adjustment ($+0.041$) reflects the Semantic and Behavioural agents pulling Knowledge Agent estimates toward the correct class boundary.}}{108}{figure.6.26}\protected@file@percent }
\newlabel{fig:tifs_consultation}{{26}{108}{Peer consultation effect on the Knowledge Agent. \textbf {Left:} Probability before versus after consultation for triggered samples (red = ransomware, blue = benign). Points above the diagonal indicate upward corrections by confident peers. \textbf {Right:} Distribution of probability adjustments ($\Delta p$). The mean positive adjustment ($+0.041$) reflects the Semantic and Behavioural agents pulling Knowledge Agent estimates toward the correct class boundary}{figure.6.26}{}}
