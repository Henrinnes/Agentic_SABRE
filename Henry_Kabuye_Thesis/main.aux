\@writefile{toc}{\contentsline {subsection}{\numberline {6.7.4}Epistemic Uncertainty Analysis}{107}{subsection.6.7.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces Epistemic uncertainty ($\sigma $) distributions for benign and ransomware samples across all three agents. The Semantic Agent is near-deterministic ($\bar  {\sigma } \approx 0$); the Behavioural Agent shows low but non-trivial uncertainty ($\bar  {\sigma } \approx 0.013$); the Knowledge Agent exhibits the highest uncertainty ($\bar  {\sigma } \approx 0.055$), consistent with its smaller training set and heuristic labels.}}{107}{figure.6.25}\protected@file@percent }
\newlabel{fig:tifs_uncertainty}{{25}{107}{Epistemic uncertainty ($\sigma $) distributions for benign and ransomware samples across all three agents. The Semantic Agent is near-deterministic ($\bar {\sigma } \approx 0$); the Behavioural Agent shows low but non-trivial uncertainty ($\bar {\sigma } \approx 0.013$); the Knowledge Agent exhibits the highest uncertainty ($\bar {\sigma } \approx 0.055$), consistent with its smaller training set and heuristic labels}{figure.6.25}{}}
